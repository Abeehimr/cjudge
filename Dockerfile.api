FROM python:3.14-slim

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --system --uid 10001 cjudge
RUN mkdir /var/lib/cjudge-tasks && chown 10001:10001 /var/lib/cjudge-tasks && chmod 700 /var/lib/cjudge-tasks
RUN mkdir /var/lib/cjudge-labs && chown 10001:10001 /var/lib/cjudge-labs && chmod 700 /var/lib/cjudge-labs
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations
ENV PYTHONPATH=/app/src
USER cjudge

CMD ["uvicorn", "cjudge.api:app", "--host", "0.0.0.0", "--port", "8000"]
